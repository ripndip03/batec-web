# Public site URL (used for SEO metadata, sitemap and canonical URLs)
NEXT_PUBLIC_SITE_URL=https://batec.example

# Show unpublished product variants with "pending" placeholders (design review only).
# Never set to true in production.
NEXT_PUBLIC_SHOW_DRAFTS=true

# Newsletter provider (to be chosen). Leave empty: the API route answers 501 until configured.
NEWSLETTER_PROVIDER=
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=
